# ─────────────────────────────────────────────────────────────────────────────
# ServiceSync — environment template
# Copy to `.env` and fill in real values. NEVER commit a real `.env` (secrets).
# All variable names are CASE-SENSITIVE (see app/core/config.py).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ───────────────────────────────────────────────────────────────────
PROJECT_NAME=ServiceSync
VERSION=1.0.0
# Set to False for production; True runs the demo seed + mock payments.
DEMO_MODE=True

# REQUIRED. Generate a strong key:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Must be >= 32 bytes. App refuses to boot with the insecure default.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# REQUIRED. Async DB URL (Postgres recommended; sqlite+aiosqlite works for dev).
#   postgres:  postgresql+asyncpg://user:pass@host:5432/servicesync
#   sqlite:    sqlite+aiosqlite:///./servicesync.db
DATABASE_URL=sqlite+aiosqlite:///./servicesync.db

# ── LLM backend (model-agnostic — avoids Gemini lock-in) ───────────────────
# One of: gemini | groq | ollama
AI_PROVIDER=gemini
# Gemini (default). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq (generous free tier, OpenAI-compatible) — good cheap default.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Ollama (fully local, zero per-call cost).
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# ── Payments ────────────────────────────────────────────────────────────────
# Active processor resolves as: stripe > paystack > demo (mock).
# Leave all payment keys unset to run in demo/mock mode.

# Stripe (primary; cards). https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE=True

# Paystack (NG/Africa: cards, bank transfer, M-Pesa, Opay, MTN MoMo…).
# When both keys are set, Paystack becomes the live processor.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Charge currency must be enabled on your processor account.
PAYMENT_CURRENCY=USD          # Stripe charge currency
PAYSTACK_CURRENCY=NGN         # Paystack charge currency
USD_NGN_RATE=1600.0           # indicative FX used to derive Paystack amount

# ── CALL-E / ServiceSync Voice (AI phone dispatcher) ────────────────────────
# Leave CALL_E_API_KEY unset to keep demo mode working (dispatch no-ops).
# Get credentials from the CALL-E Developer API (base https://api.heycall-e.com).
CALL_E_API_KEY=
CALL_E_BASE_URL=https://api.heycall-e.com
CALL_E_FROM_PHONE=           # caller ID CALL-E should use (E.164, optional)
CALL_E_WEBHOOK_BASE_URL=     # public base, e.g. https://your-app.onrender.com
VOICE_DISPATCH_ENABLED=False  # flip True once CALL-E is wired & tested

# ── Channels / integrations (all optional) ─────────────────────────────────
# WhatsApp Cloud API (Meta Graph)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Meta webhook verify/signature
META_VERIFY_TOKEN=
META_APP_SECRET=

# Telegram bot webhook secret (BotFather /setWebhook secret-token)
TELEGRAM_WEBHOOK_SECRET=

# Email (SMTP) — unset = verification/reset emails are skipped (demo-safe)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=True
EMAIL_FROM=noreply@servicesync.app
FRONTEND_URL=                 # public base URL for emailed links

# ── Storage (pick one; unset = local app/static/uploads) ───────────────────
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_CUSTOM_DOMAIN=

# ── Infrastructure ──────────────────────────────────────────────────────────
# Redis (optional). When set, WS broadcasts fan out via pub/sub across instances.
REDIS_URL=

# ── Feature gating (keep OFF by default) ────────────────────────────────────
EMAIL_VERIFICATION_REQUIRED=False
ADMIN_2FA_REQUIRED=False

# ── Monetization (safe to leave at defaults) ────────────────────────────────
PLATFORM_FEE_PCT_FREE=0.15
PLATFORM_FEE_PCT_PREMIUM=0.05
PREMIUM_TRIAL_DAYS=14
PREMIUM_MONTHLY_PRICE=29.0
CLEARING_DAYS=5
PREMIUM_CLEARING_DAYS=2

# Admin 2FA recovery bypass (self-hosted only). Set to a strong code; an admin may use it at the OTP prompt.
ADMIN_2FA_BYPASS_CODE=ADMIN-2FA-HJZEC01L2R
